# Environment Configuration for ACS Backend
# Copy this file to .env and fill in the values below.
#
# ─── HOW TO SET UP MYSQL FOR LOCAL TESTING ───────────────────────────────
#
#  1. Install MySQL (https://dev.mysql.com/downloads/mysql/) and start the
#     MySQL server.
#
#  2. Open a MySQL client (MySQL Workbench, DBeaver, or command line) and
#     create the database:
#
#       CREATE DATABASE ccs CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
#  3. Fill in DB_USER and DB_PASSWORD below with your MySQL credentials
#     (default user is "root"; the password is whatever you set during install).
#
#  4. Run the seed script from the backend folder to populate test data:
#
#       cd backend
#       npm run seed
#
#  5. Start the backend server:
#
#       npm run dev
#
# ─────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MySQL Database ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ccs
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ─── JWT Authentication ───────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# ─── Frontend Origin (CORS) ───────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
