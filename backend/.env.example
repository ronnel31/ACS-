# Environment Configuration for ACS Backend

# ─── Server ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────
# For local development (no MySQL required), leave DB_HOST and DB_PASSWORD
# empty — the server will automatically use SQLite (ccs_dev.sqlite).
#
# To force SQLite explicitly regardless of other settings:
#   DB_DIALECT=sqlite
#   SQLITE_PATH=./ccs_dev.sqlite   # optional: custom path for the DB file
#
# To use MySQL, fill in ALL fields below (DB_HOST and DB_PASSWORD are required):
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ccs
DB_USER=root
DB_PASSWORD=

# ─── JWT Authentication ───────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# ─── Frontend Origin (CORS) ───────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
