# Environment Configuration for ACS Backend

# ─── Server ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MySQL Database ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ccs
DB_USER=root
DB_PASSWORD=your_password_here

# ─── JWT Authentication ───────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# ─── Frontend Origin (CORS) ───────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
